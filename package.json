{
  "name": "webhook-api-sync-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Personal/demo Node.js webhook inbox and API sync service.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
